rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function isValidBrandSettings(settings) {
      return settings is map &&
             settings.keys().hasOnly(['primaryColor', 'secondaryColor', 'accentColor', 'logoUrl', 'logoPosition', 'companyType', 'targetAudience', 'toneOfVoice', 'companyDescription', 'usp', 'visualStyleType', 'illustrationStyle', 'defaultHashtags']) &&
             settings.primaryColor is string &&
             settings.secondaryColor is string &&
             settings.accentColor is string &&
             (settings.logoUrl == null || settings.logoUrl is string) &&
             settings.logoPosition is string &&
             settings.companyType is string &&
             settings.targetAudience is string &&
             settings.toneOfVoice is string &&
             settings.companyDescription is string &&
             (!('usp' in settings) || settings.usp is string) &&
             (!('visualStyleType' in settings) || settings.visualStyleType is string) &&
             (!('illustrationStyle' in settings) || settings.illustrationStyle is string) &&
             (!('defaultHashtags' in settings) || settings.defaultHashtags is string);
    }

    function isValidTemplates(templates) {
      return templates is list && templates.size() <= 20;
    }

    function isValidCompany(data) {
      return hasOnlyAllowedFields(['name', 'ownerId', 'brandSettings', 'templates', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             isValidBrandSettings(data.brandSettings) &&
             (!('templates' in data) || isValidTemplates(data.templates)) &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Collections
    // ===============================================================

    match /companies/{companyId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && isValidCompany(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) && 
                       isValidCompany(request.resource.data) &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
